# Environment Variables Example for VetCheck
# Copy this file to .env and provide your actual API key for local development:
# cp .env.example .env

# GEMINI_API_KEY: Required for multimodal AI image triage via Google Gemini SDK.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# NOTE: In production or AI Studio Cloud Run deployments, this key is securely injected server-side.
GEMINI_API_KEY=your_gemini_api_key_here

# GOOGLE_MAPS_API_KEY: Required for live Nearby Veterinary Hospitals search (Places API New & Geocoding API).
# Obtain from Google Cloud Console: https://console.cloud.google.com/google/maps-apis/credentials
# Or use the free Maps Demo Key for prototyping: https://mapsplatform.google.com/maps-demo-key
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# WEB PUSH / VAPID CONFIGURATION (Optional - auto-generated if omitted)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vetcheck.app

# PORT: Server port (defaults to 3000)
PORT=3000
